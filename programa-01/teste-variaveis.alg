algoritmo "teste-variaveis"
var
idade: inteiro
nome: caractere
peso: real


inicio
escreva("Digite seu nome: ")
leia(nome)
escreval()

escreva("Digite sua idade: ")
leia(idade)
escreval()

escreva("Digite seu peso: ")
leia(peso)
escreval()

escreval ("Seus dados são:")
escreval("Nome: ", nome)
escreval("Idade: ", idade)
escreval("Peso: ", peso)

fimalgoritmo